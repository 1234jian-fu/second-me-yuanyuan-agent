EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phone app should call your own AI proxy / computer hub, not raw model provider keys.
# Local web preview can use http://127.0.0.1:8787/v1/ai.
# Physical phone should use http://YOUR_COMPUTER_LAN_IP:8787/v1/ai.
EXPO_PUBLIC_AI_PROXY_URL=http://127.0.0.1:8787/v1/ai
EXPO_PUBLIC_HUB_URL=http://127.0.0.1:8787
EXPO_PUBLIC_AI_PROXY_TOKEN=
EXPO_PUBLIC_AI_PROVIDER=openai-compatible
EXPO_PUBLIC_AI_MODEL=gpt-5.2
EXPO_PUBLIC_AI_TIMEOUT_MS=30000

# Optional fallback proxy endpoints. The app tries them in order if primary fails.
EXPO_PUBLIC_AI_FALLBACK_1_URL=
EXPO_PUBLIC_AI_FALLBACK_1_TOKEN=
EXPO_PUBLIC_AI_FALLBACK_1_PROVIDER=openai-compatible
EXPO_PUBLIC_AI_FALLBACK_1_MODEL=claude-haiku-4-5-20251001

EXPO_PUBLIC_AI_FALLBACK_2_URL=
EXPO_PUBLIC_AI_FALLBACK_2_TOKEN=
EXPO_PUBLIC_AI_FALLBACK_2_PROVIDER=openai-compatible
EXPO_PUBLIC_AI_FALLBACK_2_MODEL=

# Computer hub / local center node
HUB_PORT=8787
HUB_HOST=0.0.0.0
HUB_ALLOW_ORIGIN=*
HUB_API_TOKEN=

# Primary upstream model provider
AI_PRIMARY_PROVIDER=openai-compatible
AI_PRIMARY_BASE_URL=https://rapi.asia/v1
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=gpt-5.2

# Optional fallback provider
AI_FALLBACK_1_PROVIDER=deepseek-compatible
AI_FALLBACK_1_BASE_URL=https://api.deepseek.com
AI_FALLBACK_1_API_KEY=
AI_FALLBACK_1_MODEL=deepseek-v4-pro

# Optional second fallback provider
AI_FALLBACK_2_PROVIDER=openai-compatible
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_MODEL=

# Optional local/offline TTS through sherpa-onnx on the computer Hub.
# Keep large model files under ./models/ and do not commit them.
TTS_PROVIDER=browser
SHERPA_ONNX_TTS_ENGINE=matcha
SHERPA_ONNX_TTS_MODEL_DIR=./models/matcha-icefall-zh-baker
SHERPA_ONNX_TTS_ACOUSTIC_MODEL=model-steps-3.onnx
SHERPA_ONNX_TTS_VOCODER=./models/vocos-22khz-univ.onnx
SHERPA_ONNX_TTS_LEXICON=lexicon.txt
SHERPA_ONNX_TTS_TOKENS=tokens.txt
SHERPA_ONNX_TTS_DATA_DIR=
SHERPA_ONNX_TTS_RULE_FSTS=phone.fst,date.fst,number.fst
SHERPA_ONNX_TTS_VOICE_ID=0
SHERPA_ONNX_TTS_SPEED=1.0
SHERPA_ONNX_TTS_SILENCE_SCALE=0.2
